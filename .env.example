NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://theceylonedition.com

# Optional private partner hero + Ceylo demo. OFF by default. Requires BOTH switches.
# Accepted only in local development or Vercel Preview on commercial-readiness/staging.
# Preview also requires the exact staging Supabase URL (hvcggnuptrcsxtrcjnre).
# Production is always denied, even when these values are set.
CEYLON_PARTNER_DEMO_HERO=0
CEYLON_DEMO_SCOPE=

# Voice requires a supporting browser and explicit user microphone permission.
# Demo homepage alone allows same-origin microphone use; other routes deny it.

# Server and import scripts only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
